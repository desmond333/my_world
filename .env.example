# URL бэкенда (Cloudflare Worker). Пример: https://tau-api.example.workers.dev
VITE_API_URL=

# Отладочные разблокировки магазина/премиума. В dev включены автоматически,
# в production-сборке выключены. Можно форсировать: true/false.
# VITE_SHOP_DEV_UNLOCK_ALL=false
# VITE_PREMIUM_DEV_UNLOCK_ALL=false

# Опционально: TMDB для раздела «Медиа». Можно указать адрес воркера-прокси или токен.
VITE_TMDB_PROXY_URL=
VITE_TMDB_TOKEN=
